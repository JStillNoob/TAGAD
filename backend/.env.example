# Generate a unique value for every installation. Never commit the real key.
SECRET_KEY=replace-with-a-long-random-secret-key

# Local development only. Use False in production.
DJANGO_DEBUG=True

# PostgreSQL connection
DB_NAME=tagad_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

# Local Vue development origins
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Password recovery. Console output prints reset emails in the Django terminal.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT_SECONDS=3600
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=TAGAD <noreply@localhost>

# Fill these only when EMAIL_BACKEND uses Django's SMTP backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Optional presentation-processing limits and LibreOffice executable override
PRESENTATION_MAX_UPLOAD_BYTES=52428800
PRESENTATION_MAX_EXPANDED_BYTES=262144000
PRESENTATION_MAX_SLIDES=300
LIBREOFFICE_PATH=

# Stage 1 engagement pipeline. Keep the simulator off outside development.
ENABLE_PIPELINE_SIMULATOR=False
# Generate a long random value. This credential is for the backend AI worker only.
PIPELINE_API_KEY=
ENGAGEMENT_ALERT_CONSECUTIVE_WINDOWS=3
