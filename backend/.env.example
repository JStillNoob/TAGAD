# Generate a unique value for every installation. Never commit the real key.
SECRET_KEY=replace-with-a-long-random-secret-key

# Local development only. Use False in production.
DJANGO_DEBUG=True

# PostgreSQL connection
DB_NAME=tagad_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432
DB_CONNECT_TIMEOUT_SECONDS=5

# Local Vue development origins
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Password recovery. Console output prints reset emails in the Django terminal.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT_SECONDS=3600
LOGIN_THROTTLE_MAX_FAILURES=5
LOGIN_THROTTLE_CLIENT_MAX_FAILURES=25
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_BLOCK_SECONDS=900
PASSWORD_RESET_THROTTLE_MAX_REQUESTS=3
PASSWORD_RESET_THROTTLE_CLIENT_MAX_REQUESTS=15
PASSWORD_RESET_THROTTLE_WINDOW_SECONDS=900
PASSWORD_RESET_THROTTLE_BLOCK_SECONDS=900
# Keep 0 unless Django is behind this exact number of trusted reverse proxies.
TRUSTED_PROXY_COUNT=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=TAGAD <noreply@localhost>

# Fill these only when EMAIL_BACKEND uses Django's SMTP backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Optional presentation-processing limits and LibreOffice executable override
PRESENTATION_MAX_UPLOAD_BYTES=52428800
PRESENTATION_MAX_EXPANDED_BYTES=262144000
PRESENTATION_MAX_SLIDES=300
LIBREOFFICE_PATH=

# PostgreSQL backup/recovery. Paths are auto-discovered on common installations.
PG_DUMP_PATH=
PG_RESTORE_PATH=
POSTGRES_TOOL_TIMEOUT_SECONDS=300
DATABASE_BACKUP_DIRECTORY=backups

# Data retention. cleanup_data is a dry-run unless --execute is supplied.
RETENTION_FAILED_PRESENTATION_DAYS=30
RETENTION_REPORT_DAYS=365
RETENTION_ENGAGEMENT_SUMMARY_DAYS=180
RETENTION_SYSTEM_LOG_DAYS=180

# Structured operational log rotation
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=WARNING
LOG_FILE_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Stage 1 engagement pipeline. Keep the simulator off outside development.
ENABLE_PIPELINE_SIMULATOR=False
# Generate a long random value. This credential is for the backend AI worker only.
PIPELINE_API_KEY=
ENGAGEMENT_ALERT_CONSECUTIVE_WINDOWS=3

# Offline model integration. Absolute paths may point outside this repository.
# These files are only checked for readiness; Django does not load them yet.
TAGAD_YOLO_MODEL_PATH=D:\TAGAD\models\tagad_yolo11_head_v2_best.pt
TAGAD_FACE_LANDMARKER_PATH=D:\TAGAD\models\face_landmarker.task
TAGAD_SVM_MODEL_PATH=D:\TAGAD\models\tagad_engagement_svm.joblib
TAGAD_MODEL_PIPELINE_VERSION=offline-1
